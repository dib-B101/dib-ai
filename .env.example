# 이 파일을 .env 로 복사한 뒤 값을 채우십시오.
#
#     cp .env.example .env
#
# .env 는 .gitignore 에 있으므로 커밋되지 않습니다. 키를 코드에 직접 적지 마십시오.

# ---------------------------------------------------------------- 상품 검수

# 어느 벤더 형식으로 호출할지. anthropic | openai
# 사내 게이트웨이처럼 OpenAI 호환 엔드포인트라면 openai 를 씁니다.
MODERATION_PROVIDER=openai

# API 키. 위에서 고른 쪽만 채우면 됩니다.
OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# 게이트웨이 주소. OpenAI 본사를 직접 쓴다면 비워 두십시오.
# 보통 /v1 로 끝납니다.
OPENAI_BASE_URL=

# 사용할 모델. 화면에 보이는 이름이 아니라 API 용 모델 ID 여야 합니다.
MODERATION_MODEL=gemini-3.5-flash

# 구조화 출력 방식. schema | object
# 기본은 schema 입니다. 게이트웨이가 json_schema 를 거절하면 object 로 바꾸십시오.
MODERATION_JSON_MODE=schema

# ---------------------------------------------------------------- 이상거래 탐지

# 규칙 점수와 모델 점수의 결합 비율.
# 모델 트랙이 검증되기 전까지는 규칙이 전부를 차지합니다.
FRAUD_W_RULE=1.0
FRAUD_W_ML=0.0
