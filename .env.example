# 이 파일을 .env 로 복사한 뒤 값을 채우십시오.
#
#     cp .env.example .env
#
# .env 는 .gitignore 에 있으므로 커밋되지 않습니다. 키를 코드에 직접 적지 마십시오.

# ================================================================ 상품 검수

# 어느 **API 형식**으로 부를지 고릅니다. 벤더가 아니라 형식입니다.
#
#   gemini      구글 네이티브 (.../models/{모델}:generateContent)
#   openai      OpenAI Chat Completions (.../chat/completions)
#   anthropic   Anthropic Messages (.../v1/messages)
#
# SSAFY GMS 게이트웨이는 원래 벤더 주소를 뒤에 그대로 붙이는 방식이라,
# 부르려는 모델의 벤더에 맞춰 골라야 합니다.
MODERATION_PROVIDER=gemini

# 사용할 모델. 화면에 보이는 이름이 아니라 API 용 모델 ID 입니다.
MODERATION_MODEL=gemini-3.5-flash


# ---------------------------------------------------------------- gemini

# GMS 게이트웨이 주소. 뒤에 /models/{모델}:generateContent 가 붙습니다.
GEMINI_BASE_URL=https://gms.ssafy.io/gmsapi/generativelanguage.googleapis.com/v1beta
GEMINI_API_KEY=


# ---------------------------------------------------------------- openai
# GPT 모델을 쓸 때만 채우십시오.

# OPENAI_BASE_URL=https://gms.ssafy.io/gmsapi/api.openai.com/v1
# OPENAI_API_KEY=
# MODERATION_JSON_MODE=schema     # schema | object. 400 이 나면 object 로 바꿉니다


# ---------------------------------------------------------------- anthropic
# Claude 모델을 쓸 때만 채우십시오.

# ANTHROPIC_BASE_URL=https://gms.ssafy.io/gmsapi/api.anthropic.com
# ANTHROPIC_API_KEY=


# ================================================================ 이상거래 탐지

# 규칙 점수와 모델 점수의 결합 비율.
# 모델 트랙이 검증되기 전까지는 규칙이 전부를 차지합니다.
FRAUD_W_RULE=1.0
FRAUD_W_ML=0.0
