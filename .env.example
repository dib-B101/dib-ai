# 이 파일을 .env 로 복사한 뒤 값을 채우십시오.
#
#     cp .env.example .env
#
# .env 는 .gitignore 에 있으므로 커밋되지 않습니다. 키를 코드에 직접 적지 마십시오.

# ================================================================ 상품 검수

# 어느 **API 형식**으로 부를지 고릅니다. 벤더가 아니라 형식입니다.
#
#   gemini      구글 네이티브 (.../models/{모델}:generateContent)
#   openai      OpenAI Chat Completions (.../chat/completions)
#   anthropic   Anthropic Messages (.../v1/messages)
#
# SSAFY GMS 게이트웨이는 원래 벤더 주소를 뒤에 그대로 붙이는 방식이라,
# 부르려는 모델의 벤더에 맞춰 골라야 합니다.
MODERATION_PROVIDER=gemini

# 사용할 모델. 화면에 보이는 이름이 아니라 API 용 모델 ID 입니다.
MODERATION_MODEL=gemini-3.5-flash


# ---------------------------------------------------------------- gemini

# GMS 게이트웨이 주소. 뒤에 /models/{모델}:generateContent 가 붙습니다.
GEMINI_BASE_URL=https://gms.ssafy.io/gmsapi/generativelanguage.googleapis.com/v1beta
GEMINI_API_KEY=


# ---------------------------------------------------------------- openai
# GPT 모델을 쓸 때만 채우십시오.

# OPENAI_BASE_URL=https://gms.ssafy.io/gmsapi/api.openai.com/v1
# OPENAI_API_KEY=
# MODERATION_JSON_MODE=schema     # schema | object. 400 이 나면 object 로 바꿉니다


# ---------------------------------------------------------------- anthropic
# Claude 모델을 쓸 때만 채우십시오.

# ANTHROPIC_BASE_URL=https://gms.ssafy.io/gmsapi/api.anthropic.com
# ANTHROPIC_API_KEY=


# ================================================================ 이상거래 탐지

# 규칙 점수와 모델 점수의 결합 비율.
# 모델 트랙이 검증되기 전까지는 규칙이 전부를 차지합니다.
FRAUD_W_RULE=1.0
FRAUD_W_ML=0.0


# ============================================ 백엔드 연동 (REST API 명세 92~95)

# 내부 API 는 HMAC 서명으로만 열립니다. **비워 두면 열리지 않고 503 을 돌려줍니다.**
# 설정 누락이 조용히 무인증 배포로 이어지는 쪽이 훨씬 위험하기 때문입니다.

# 백엔드가 우리를 부를 때 쓰는 키 (명세의 SERVICE_HMAC). 백엔드와 같은 값이어야 합니다.
DIB_SERVICE_HMAC_SECRET=

# 우리가 백엔드 콜백을 부를 때 쓰는 키 (명세의 AI_HMAC).
DIB_AI_HMAC_SECRET=

# 콜백을 보내도 되는 호스트. 쉼표로 구분합니다.
# callbackUrl 은 백엔드가 보낸 값이라 검사 없이 쓰면 외부로 요청을 날리는 통로가 됩니다.
# **비워 두면 검사하지 않으므로 운영에서는 반드시 채우십시오.**
# DIB_CALLBACK_ALLOWED_HOSTS=api.dib.io,localhost

# 서명 방식 자체는 명세에 없어 아래 규약을 정했습니다. 백엔드와 맞춰야 합니다.
#
#   서명 대상   "{timestamp}.{요청 본문 원문}"
#   서명        HMAC-SHA256(secret, 서명 대상) 의 16진수
#   헤더        X-DIB-Timestamp: 유닉스 초
#               X-DIB-Signature: sha256=<16진수>
#
# DIB_HMAC_TIMESTAMP_HEADER=X-DIB-Timestamp
# DIB_HMAC_SIGNATURE_HEADER=X-DIB-Signature
# DIB_HMAC_MAX_SKEW=300          # 재전송 허용 오차(초)
# DIB_CALLBACK_TIMEOUT=10
# DIB_CALLBACK_ATTEMPTS=3
